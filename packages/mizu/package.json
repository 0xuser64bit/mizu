{
  "name": "mizu-ui",
  "version": "0.2.0",
  "description": "Mizu interface craft for React: accessible surfaces, interaction, data, motion and complete patterns.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mizu",
    "react",
    "components",
    "design-system",
    "motion",
    "ui"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "styles.css",
    "fonts.css",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./fonts.css": "./fonts.css",
    "./source/*": "./src/*",
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "import": "./dist/status/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20",
    "motion": ">=12 <14"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.x",
    "@fontsource/instrument-serif": "^5.x",
    "@fontsource/jetbrains-mono": "^5.x"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xuser64bit/mizu.git",
    "directory": "packages/mizu"
  },
  "homepage": "https://github.com/0xuser64bit/mizu#readme",
  "bugs": {
    "url": "https://github.com/0xuser64bit/mizu/issues"
  }
}
