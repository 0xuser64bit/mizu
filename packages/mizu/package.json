{
  "name": "mizu-ui",
  "version": "0.1.1",
  "description": "The first generation of the Mizu interface language — surfaces, motion and systems for React.",
  "type": "module",
  "license": "MIT",
  "keywords": ["mizu", "react", "components", "design-system", "motion", "ui"],
  "sideEffects": [
    "styles.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.x",
    "@fontsource/instrument-serif": "^5.x",
    "@fontsource/jetbrains-mono": "^5.x"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
